diff --git a/tests/test_install_sh_temporary_smoke_launcher.py b/tests/test_install_sh_temporary_smoke_launcher.py
new file mode 100644
index 00000000..0d415c1a
--- /dev/null
+++ b/tests/test_install_sh_temporary_smoke_launcher.py
@@ -0,0 +1,53 @@
+"""Temporary installer smokes must not rewrite the persistent Hermes launcher."""
+
+from __future__ import annotations
+
+import os
+import subprocess
+from pathlib import Path
+
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+INSTALL_SH = REPO_ROOT / "scripts" / "install.sh"
+
+
+def test_temporary_path_stage_preserves_existing_launcher(tmp_path: Path) -> None:
+    install_dir = tmp_path / "hermes-agent"
+    venv_bin = install_dir / "venv" / "bin"
+    venv_bin.mkdir(parents=True)
+    hermes_bin = venv_bin / "hermes"
+    hermes_bin.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
+    hermes_bin.chmod(0o755)
+
+    fake_home = tmp_path / "home"
+    launcher_dir = fake_home / ".local" / "bin"
+    launcher_dir.mkdir(parents=True)
+    launcher = launcher_dir / "hermes"
+    original = b"#!/bin/sh\n# persistent launcher\n"
+    launcher.write_bytes(original)
+    launcher.chmod(0o755)
+
+    env = os.environ.copy()
+    env.update({"HOME": str(fake_home), "HERMES_HOME": str(tmp_path / "profile")})
+    result = subprocess.run(
+        [
+            "bash",
+            str(INSTALL_SH),
+            "--dir",
+            str(install_dir),
+            "--hermes-home",
+            str(tmp_path / "profile"),
+            "--stage",
+            "path",
+            "--non-interactive",
+        ],
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=30,
+        check=False,
+    )
+
+    assert result.returncode == 0, result.stderr
+    assert "Safe smoke mode: skipping persistent hermes launcher update" in result.stdout
+    assert launcher.read_bytes() == original
