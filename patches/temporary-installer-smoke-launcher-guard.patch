+is_temporary_smoke_path() {
+    local candidate="${1:-}"
+    [ -n "$candidate" ] || return 1
+    case "$candidate" in
+        /tmp|/tmp/*|/var/tmp|/var/tmp/*|*/tasks/*|*/smoke/*|*/smokes/*)
+            return 0
+            ;;
+        *)
+            return 1
+            ;;
+    esac
+}
+
+is_temporary_smoke_install() {
+    is_temporary_smoke_path "$INSTALL_DIR" || is_temporary_smoke_path "$HERMES_HOME"
+}
