diff --git a/tests/hermes_cli/test_kanban_core_functionality.py b/tests/hermes_cli/test_kanban_core_functionality.py
index 5d3cac126..364eea696 100644
--- a/tests/hermes_cli/test_kanban_core_functionality.py
+++ b/tests/hermes_cli/test_kanban_core_functionality.py
@@ -517,6 +517,42 @@ def test_task_age_helper(kanban_home):
         conn.close()
 
 
+def test_workflow_snapshot_builds_task_tree_and_progress(kanban_home):
+    conn = kb.connect()
+    try:
+        root = kb.create_task(conn, title="ship workflow", assignee="lead")
+        child_a = kb.create_task(conn, title="research", assignee="worker-a", parents=[root])
+        child_b = kb.create_task(conn, title="verify", assignee="worker-b", parents=[root])
+        kb.complete_task(conn, root, result="root ready")
+        kb.complete_task(conn, child_a, result="researched")
+        snapshot = kb.workflow_snapshot(conn, root)
+    finally:
+        conn.close()
+
+    assert snapshot["root_task_id"] == root
+    assert snapshot["total_tasks"] == 3
+    assert snapshot["by_status"]["done"] == 2
+    assert snapshot["by_status"]["ready"] == 1
+    assert snapshot["progress_percent"] == 66.7
+    assert snapshot["roots"][0]["id"] == root
+    assert {child["id"] for child in snapshot["roots"][0]["children"]} == {child_a, child_b}
+
+
+def test_cli_workflow_json(kanban_home):
+    conn = kb.connect()
+    try:
+        root = kb.create_task(conn, title="root", assignee="lead")
+        child = kb.create_task(conn, title="child", assignee="worker", parents=[root])
+    finally:
+        conn.close()
+
+    out = run_slash(f"workflow {root} --json")
+    data = json.loads(out)
+    assert data["root_task_id"] == root
+    assert data["total_tasks"] == 2
+    assert data["roots"][0]["children"][0]["id"] == child
+
+
