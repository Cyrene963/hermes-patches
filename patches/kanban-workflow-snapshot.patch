+def _print_workflow_node(node: dict[str, Any], *, depth: int = 0) -> None:
+    indent = "  " * depth
+    icon = _STATUS_ICONS.get(node.get("status"), "?")
+    assignee = node.get("assignee") or "(unassigned)"
+    step = f" step={node['current_step_key']}" if node.get("current_step_key") else ""
