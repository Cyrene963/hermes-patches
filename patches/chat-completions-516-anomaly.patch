+    def detect_retryable_anomaly(self, response: Any) -> ChatCompletionsAnomalyError | None:
+        """Detect 200-level responses that are known-bad and should retry."""
+        if not self.validate_response(response):
+            return None
+        try:
+            choice = response.choices[0]
+            msg = choice.message
+        except Exception:
+            return None
+
+        finish_reason = getattr(choice, "finish_reason", None) or "stop"
+        if finish_reason != "stop":
+            return None
+        if getattr(msg, "tool_calls", None):
+            return None
+
+        content = getattr(msg, "content", None)
+        if isinstance(content, str) and content.strip():
+            return None
+        if content not in (None, ""):
+            return None
+
+        reasoning = getattr(msg, "reasoning", None)
+        reasoning_content = getattr(msg, "reasoning_content", None)
+        if reasoning_content is None and hasattr(msg, "model_extra"):
+            model_extra = getattr(msg, "model_extra", None) or {}
+            if isinstance(model_extra, dict):
+                reasoning_content = model_extra.get("reasoning_content")
+
+        if not reasoning and not reasoning_content:
+            return None
+
+        reasoning_tokens = _extract_reasoning_tokens_from_usage(
+            getattr(response, "usage", None)
+        )
+        if reasoning_tokens != 516:
+            return None
+
+        return ChatCompletionsAnomalyError(
+            "OpenAI-compatible route returned a known-bad reasoning-only response "
+            "(reasoning_tokens=516, no visible content, no tool calls). Retrying.",
+            code="reasoning_tokens_516_anomaly",
+            status_code=502,
+            details={
+                "reasoning_tokens": reasoning_tokens,
+                "finish_reason": finish_reason,
+                "has_reasoning": True,
+            },
+        )
