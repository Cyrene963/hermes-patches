+    async def _handle_gpmode_command(self, event: MessageEvent) -> str:
+        """Handle /gpmode for per-group reply-mode switching."""
+        source = event.source
+        if source.chat_type == "dm":
+            return "`/gpmode` only applies to group/channel/thread chats. DMs always behave like private Hermes sessions."
+        if source.platform != Platform.TELEGRAM:
+            return "`/gpmode` is currently implemented for Telegram groups/topics."
+
+        from gateway.group_mode import get_group_mode, normalize_group_mode, set_group_mode
+
+        raw_args = event.get_command_args().strip()
+        requested = normalize_group_mode(raw_args or "status")
+        thread_id = str(source.thread_id) if source.thread_id else None
+        current = get_group_mode(
+            _hermes_home,
+            platform=source.platform.value,
+            chat_id=str(source.chat_id),
+            thread_id=thread_id,
+        )
+        descriptions = {
+            "mention": "mention-only: reply only to explicit Telegram triggers such as @mention, reply-to-bot, or /cmd@botname; unmentioned group chatter may still be observed if enabled.",
+            "free": "free-response: reply to every allowed group message in this chat/topic.",
+            "auto": "semantic-auto: explicit Telegram triggers always work; otherwise a lightweight semantic classifier decides whether the current message is asking the assistant to respond.",
+        }
+        if requested in {None, "status"}:
+            usage = "Usage: `/gpmode status|mention|free|auto`"
+            return f"Group reply mode: `{current}`\n{descriptions.get(current, '')}\n{usage}"
+        new_mode = set_group_mode(
+            _hermes_home,
+            platform=source.platform.value,
+            chat_id=str(source.chat_id),
+            thread_id=thread_id,
+            mode=requested,
+        )
+        return f"Group reply mode set to `{new_mode}`.\n{descriptions[new_mode]}"
+
