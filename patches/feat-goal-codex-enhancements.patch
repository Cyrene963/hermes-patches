+        logger.debug(
+            "Semantic skill retrieval: %d skills injected (of %d total) for query: %r",
+            len(combined),
+            db.get_skill_count(),
+            user_message[:50],
+        )
+        logger.info("SKILL_STATS: method=fts5 count=%d total=%d", len(combined), db.get_skill_count())
