+        # ── Token budget tracking (Codex /goal) ──────────────────────
+        if tokens_used > 0:
+            state.tokens_used += tokens_used
+        if state.created_at > 0:
+            state.time_used_seconds = time.time() - state.created_at
+        state.tool_calls_in_turn = tool_calls_count
