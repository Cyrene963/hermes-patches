-        for p in [r'¥\s*\d+', r'\$\s*\d+', r'€\s*\d+', r'\d+\s*(块钱|元|美元|人民币|港币|美金)', r'每[月天年]\s*\d+', r'\d+\s*/\s*[月天年]', r'(free|免费|收费|付费|定价|pricing|cost)']:
-            if re.search(p, response, re.IGNORECASE): violations.append("price_claim"); break
-        # Number claims
