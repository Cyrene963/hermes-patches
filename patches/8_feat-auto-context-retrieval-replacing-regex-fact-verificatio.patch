From fc89fee8109208b581cc7ade7ecda01c72ff21e5 Mon Sep 17 00:00:00 2001
From: Cyrene963 <Nitrogen@users.noreply.github.com>
Date: Sun, 3 May 2026 18:37:57 +0800
Subject: [PATCH] feat: auto-context retrieval replacing regex fact
 verification gate

- Remove regex-based fact_verification_gate (keyword matching)
- Add auto session_search alongside hindsight prefetch
- Inject retrieval results as system message (higher attention)
- Config: agent.auto_context.enabled, .session_limit
- Semantic search via hindsight embeddings, NOT keyword matching
---
 run_agent.py | 130 ++++++++++++++++++++++++---------------------------
 1 file changed, 61 insertions(+), 69 deletions(-)

diff --git a/run_agent.py b/run_agent.py
index 662044be8..2b5f3686b 100644
--- a/run_agent.py
+++ b/run_agent.py
@@ -1829,16 +1829,18 @@ class AIAgent:
             self._skill_enforcement_enabled = False
             self._skill_enforcement_mode = "warn"
 
-        # Fact verification gate config
-        _fact_ver = _agent_section.get("fact_verification", {})
-        if isinstance(_fact_ver, dict):
-            self._fact_verification_enabled = _fact_ver.get("enabled", True)
-            self._fact_verification_cooldown = int(_fact_ver.get("cooldown", 3))
-            self._fact_verification_mode = _fact_ver.get("mode", "block")
+        # Auto-context retrieval: automatically search hindsight + session
+        # history before each API call and inject results into the prompt.
+        # This is semantic (hindsight uses embeddings), NOT keyword matching.
+        # Config: agent.auto_context.enabled (bool, default True)
+        #         agent.auto_context.session_limit (int, default 3)
+        _auto_ctx = _agent_section.get("auto_context", {})
+        if isinstance(_auto_ctx, dict):
+            self._auto_context_enabled = _auto_ctx.get("enabled", True)
+            self._auto_context_session_limit = int(_auto_ctx.get("session_limit", 3))
         else:
-            self._fact_verification_enabled = True
-            self._fact_verification_cooldown = 3
-            self._fact_verification_mode = "block"
+            self._auto_context_enabled = True
+            self._auto_context_session_limit = 3
 
         # App-level API retry count (wraps each model API call).  Default 3,
         # overridable via agent.api_max_retries in config.yaml.  See #11616.
@@ -10466,38 +10468,15 @@ class AIAgent:
         return final_response
 
