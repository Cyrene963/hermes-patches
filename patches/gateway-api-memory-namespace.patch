     return default
 
 
+def _identity_from_gateway_session_key(session_key: Optional[str]) -> tuple[Optional[str], Optional[str], Optional[str], Optional[str]]:
+    """Infer user/chat identity and memory namespace from stable API session keys."""
+    if not session_key:
+        return None, None, None, None
+    raw = str(session_key).strip()
+    if not raw:
+        return None, None, None, None
+
+    parts = [part for part in raw.split(":") if part]
+    if len(parts) >= 2 and parts[0] == "telegram":
+        if parts[1] == "group" and len(parts) >= 3:
+            return None, parts[2], "group", f"telegram:group:{parts[2]}"
+        if parts[1] in {"dm", "private"} and len(parts) >= 3:
+            return parts[2], parts[2], "dm", f"telegram:{parts[2]}"
+        return parts[1], parts[1], "dm", f"telegram:{parts[1]}"
+
+    if len(parts) >= 5 and parts[0] == "agent" and parts[2] == "telegram":
+        if parts[3] == "group":
+            return None, parts[4], "group", f"telegram:group:{parts[4]}"
+        if parts[3] in {"dm", "private"}:
+            return parts[4], parts[4], "dm", f"telegram:{parts[4]}"
+
+    return None, None, None, None
+
+
 def _normalize_chat_content(
