@@ -0,0 +1,73 @@
+import os
+import sys
+import types
+from unittest.mock import patch
+
+import pytest
+
+from hermes_cli.auth import AuthError, resolve_provider
+from hermes_cli import runtime_provider as rp
+
+
+def _clear_provider_env(monkeypatch):
+    for key in list(os.environ):
+        if key.endswith(("_API_KEY", "_TOKEN", "_SECRET", "_KEY")):
+            monkeypatch.delenv(key, raising=False)
+    for key in (
+        "OPENAI_BASE_URL",
+        "OPENROUTER_BASE_URL",
+        "CUSTOM_BASE_URL",
+        "HERMES_INFERENCE_PROVIDER",
+        "AWS_ACCESS_KEY_ID",
+        "AWS_SECRET_ACCESS_KEY",
+        "AWS_SESSION_TOKEN",
+        "AWS_PROFILE",
+        "AWS_DEFAULT_PROFILE",
+        "AWS_WEB_IDENTITY_TOKEN_FILE",
+        "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI",
+        "AWS_CONTAINER_CREDENTIALS_FULL_URI",
+        "AWS_BEARER_TOKEN_BEDROCK",
+    ):
+        monkeypatch.delenv(key, raising=False)
+
+
+def _disable_bedrock_autodetect(monkeypatch):
+    monkeypatch.setitem(
+        sys.modules,
+        "agent.bedrock_adapter",
+        types.SimpleNamespace(has_aws_credentials=lambda: False),
+    )
+
+
+def test_auto_provider_does_not_treat_openai_key_as_openrouter(monkeypatch):
+    _clear_provider_env(monkeypatch)
+    _disable_bedrock_autodetect(monkeypatch)
+    monkeypatch.setenv("OPENAI_API_KEY", "sk-openai-test")
+
+    with patch("hermes_cli.auth._load_auth_store", return_value={}), \
+         patch("hermes_cli.auth.PROVIDER_REGISTRY", {}), \
+         pytest.raises(AuthError) as excinfo:
+        resolve_provider("auto")
+
+    assert excinfo.value.code == "no_provider_configured"
+
+
+def test_auto_provider_uses_openrouter_key_for_openrouter(monkeypatch):
+    _clear_provider_env(monkeypatch)
+    monkeypatch.setenv("OPENROUTER_API_KEY", "sk-or-test")
+
+    with patch("hermes_cli.auth._load_auth_store", return_value={}):
+        assert resolve_provider("auto") == "openrouter"
+
+
+def test_openrouter_runtime_does_not_use_openai_key(monkeypatch):
+    _clear_provider_env(monkeypatch)
+    monkeypatch.setenv("OPENAI_API_KEY", "sk-openai-test")
+    monkeypatch.setattr(rp, "_get_model_config", lambda: {"provider": "openrouter"})
+    monkeypatch.setattr(rp, "load_pool", lambda provider: None)
+
+    resolved = rp.resolve_runtime_provider(requested="openrouter")
+
+    assert resolved["provider"] == "openrouter"
+    assert resolved["base_url"] == rp.OPENROUTER_BASE_URL
+    assert resolved["api_key"] == ""
