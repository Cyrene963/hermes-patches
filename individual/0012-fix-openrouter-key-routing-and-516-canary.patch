+"""Live canary for the chat-completions 516 anomaly guard.
+
+Opt-in only:
+    HERMES_LIVE_TESTS=1 pytest -q -o addopts='' \
+        tests/run_agent/test_chat_completions_516_anomaly_live.py
+
+Optional targeting:
+    HERMES_LIVE_TESTS=1 HERMES_516_CANARY_PROVIDER='custom:my-route' \
+        HERMES_516_CANARY_MODEL='provider/model-name' pytest -q -o addopts='' \
+        tests/run_agent/test_chat_completions_516_anomaly_live.py
+
+This test does not force a provider to emit the anomaly. It proves the live
+route is reachable, captures the raw response shape from the CURRENT runtime
+provider, and asserts that Hermes' transport-level detector agrees with the
+observed payload. If a real route returns the known bad
+``reasoning_tokens == 516`` reasoning-only packet, this test will fail loudly
+unless the detector fires.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from hermes_cli.env_loader import load_hermes_dotenv
+from hermes_cli.runtime_provider import resolve_runtime_provider
+
+
+load_hermes_dotenv(hermes_home=str(Path.home() / ".hermes"))
+
+LIVE = os.environ.get("HERMES_LIVE_TESTS") == "1"
+LIVE_PROVIDER = os.environ.get("HERMES_516_CANARY_PROVIDER", "").strip() or None
+LIVE_MODEL = os.environ.get("HERMES_516_CANARY_MODEL", "").strip() or None
+try:
+    LIVE_RUNTIME_SNAPSHOT = resolve_runtime_provider(
+        requested=LIVE_PROVIDER,
+        target_model=LIVE_MODEL,
+    )
+    LIVE_RUNTIME_ERROR = ""
+except Exception as exc:  # pragma: no cover - live-env dependent
+    LIVE_RUNTIME_SNAPSHOT = None
+    LIVE_RUNTIME_ERROR = f"{type(exc).__name__}: {exc}"
+
+
+def _looks_credential_like(value: str) -> bool:
+    lowered = (value or "").lower()
+    return lowered.startswith(("sk-", "sk-or-", "sess-", "tok-"))
+
+
+def _redact(value: Any) -> Any:
+    if isinstance(value, dict):
+        return {k: _redact(v) for k, v in value.items()}
+    if isinstance(value, list):
+        return [_redact(v) for v in value]
+    if isinstance(value, str):
+        return "***REDACTED***" if _looks_credential_like(value) else value
+    return value
+
+
+def _jsonable(value: Any) -> Any:
+    if hasattr(value, "model_dump"):
+        return value.model_dump(mode="json")
+    if hasattr(value, "dict"):
+        try:
+            return value.dict()
+        except Exception:
+            pass
+    if isinstance(value, dict):
+        return {k: _jsonable(v) for k, v in value.items()}
+    if isinstance(value, list):
+        return [_jsonable(v) for v in value]
+    if hasattr(value, "__dict__"):
+        return {k: _jsonable(v) for k, v in vars(value).items() if not k.startswith("_")}
+    return value
+
+
+def _message_reasoning_content(message: Any) -> Any:
+    direct = getattr(message, "reasoning_content", None)
+    if direct is not None:
+        return direct
+    model_extra = getattr(message, "model_extra", None) or {}
+    if isinstance(model_extra, dict):
+        return model_extra.get("reasoning_content")
+    return None
+
+
+def _extract_reasoning_tokens(usage: Any) -> int:
+    if usage is None:
+        return 0
+    output_details = getattr(usage, "output_tokens_details", None)
+    if output_details is not None:
+        return int(getattr(output_details, "reasoning_tokens", 0) or 0)
+    completion_details = getattr(usage, "completion_tokens_details", None)
+    if completion_details is not None:
+        return int(getattr(completion_details, "reasoning_tokens", 0) or 0)
+    return 0
+
+
+def _print_trace(label: str, payload: Any) -> None:
+    print(f"\n--- {label} ---")
+    print(json.dumps(_redact(_jsonable(payload)), ensure_ascii=False, indent=2, sort_keys=True))
+
+
+def _resolve_live_runtime() -> dict[str, Any]:
+    if LIVE_RUNTIME_SNAPSHOT is None:
+        pytest.skip(f"runtime provider unavailable for live test: {LIVE_RUNTIME_ERROR}")
+    runtime = dict(LIVE_RUNTIME_SNAPSHOT)
+    if runtime.get("api_mode") != "chat_completions":
+        pytest.skip(
+            f"current runtime api_mode is {runtime.get('api_mode')!r}, not chat_completions"
+        )
+    if not runtime.get("api_key"):
+        pytest.skip("current runtime provider has no usable api_key")
+    if not runtime.get("base_url"):
+        pytest.skip("current runtime provider has no base_url")
+    if not runtime.get("model"):
+        pytest.skip("current runtime provider has no model")
+    return runtime
+
+
+pytestmark = [
+    pytest.mark.skipif(not LIVE, reason="live-only — set HERMES_LIVE_TESTS=1"),
+]
+
+
+def test_live_chat_completions_route_reports_516_anomaly_consistently():
+    from openai import OpenAI
+
+    from agent.transports.chat_completions import (
+        ChatCompletionsAnomalyError,
+        ChatCompletionsTransport,
+    )
+
+    runtime = _resolve_live_runtime()
+    client = OpenAI(api_key=runtime["api_key"], base_url=runtime["base_url"])
+    transport = ChatCompletionsTransport()
+
+    request = {
+        "model": runtime["model"],
+        "messages": [
+            {
+                "role": "user",
+                "content": (
+                    "Respond with a single short sentence about the number 516. "
+                    "Do not call tools."
+                ),
+            }
+        ],
+        "max_tokens": 128,
+        "timeout": 90,
+    }
+    _print_trace("runtime", {
+        "provider": runtime.get("provider"),
+        "model": runtime.get("model"),
+        "base_url": runtime.get("base_url"),
+        "api_mode": runtime.get("api_mode"),
+    })
+    _print_trace("request", request)
+
+    response = client.chat.completions.create(**request)
+    _print_trace("raw response", response)
+
+    choice = response.choices[0]
+    message = choice.message
+    reasoning_tokens = _extract_reasoning_tokens(getattr(response, "usage", None))
+    has_visible_content = bool(
+        isinstance(getattr(message, "content", None), str)
+        and getattr(message, "content", "").strip()
+    )
+    has_tool_calls = bool(getattr(message, "tool_calls", None))
+    has_reasoning = bool(
+        getattr(message, "reasoning", None) or _message_reasoning_content(message)
+    )
+
+    anomaly = transport.detect_retryable_anomaly(response)
+    summary = {
+        "finish_reason": getattr(choice, "finish_reason", None),
+        "reasoning_tokens": reasoning_tokens,
+        "has_visible_content": has_visible_content,
+        "has_tool_calls": has_tool_calls,
+        "has_reasoning": has_reasoning,
+        "detector_fired": anomaly is not None,
+        "detector_type": type(anomaly).__name__ if anomaly else None,
+    }
+    _print_trace("summary", summary)
+
+    if reasoning_tokens == 516 and not has_visible_content and not has_tool_calls and has_reasoning:
+        assert isinstance(anomaly, ChatCompletionsAnomalyError)
+        assert anomaly.status_code == 502
+        assert anomaly.code == "reasoning_tokens_516_anomaly"
+    else:
+        assert anomaly is None
