+  resize(); addEventListener('resize',resize);
+  const N=Math.min(40,Math.floor(W*H/25000));
+  for(let i=0;i<N;i++) nodes.push({
+    x:Math.random()*W, y:Math.random()*H,
+    vx:(Math.random()-0.5)*0.3, vy:(Math.random()-0.5)*0.3,
