+"""Persistent per-chat group reply mode for messaging gateways."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any
+
+VALID_GROUP_MODES = frozenset({"mention", "free", "auto"})
+DEFAULT_GROUP_MODE = "config"
+
+
+def _state_path(hermes_home: Path) -> Path:
+    return Path(hermes_home) / "gateway_group_modes.json"
+
+
+def normalize_group_mode(value: Any) -> str | None:
+    text = str(value or "").strip().lower().replace("_", "-")
+    aliases = {
+        "status": "status",
+        "show": "status",
+        "strict": "mention",
+        "mentions": "mention",
+        "mention-only": "mention",
+        "at": "mention",
+        "@": "mention",
+        "on-mention": "mention",
+        "free-response": "free",
+        "free-response-chats": "free",
+        "always": "free",
+        "all": "free",
+        "open": "free",
+        "smart": "auto",
+        "auto-reply": "auto",
+        "autonomous": "auto",
+    }
+    text = aliases.get(text, text)
+    if text in VALID_GROUP_MODES or text == "status":
+        return text
+    return None
+
+
+def group_mode_key(platform: str, chat_id: str, thread_id: str | None = None) -> str:
+    base = f"{str(platform or '').strip().lower()}:{str(chat_id or '').strip()}"
+    thread = str(thread_id or "").strip()
+    if thread:
+        return f"{base}:{thread}"
+    return base
+
+
+def _load_state(hermes_home: Path) -> dict[str, str]:
+    path = _state_path(hermes_home)
+    try:
+        raw = json.loads(path.read_text())
+    except FileNotFoundError:
+        return {}
+    except Exception:
+        return {}
+    if not isinstance(raw, dict):
+        return {}
+    modes: dict[str, str] = {}
+    for key, value in raw.items():
+        mode = normalize_group_mode(value)
+        if mode in VALID_GROUP_MODES:
+            modes[str(key)] = mode
+    return modes
+
+
+def _write_state(hermes_home: Path, modes: dict[str, str]) -> None:
+    path = _state_path(hermes_home)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_suffix(path.suffix + ".tmp")
+    tmp.write_text(json.dumps(modes, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
+    tmp.replace(path)
+
+
+def get_group_mode(
+    hermes_home: Path,
+    *,
+    platform: str,
+    chat_id: str,
+    thread_id: str | None = None,
+    default: str | None = DEFAULT_GROUP_MODE,
+) -> str | None:
+    modes = _load_state(hermes_home)
+    key = group_mode_key(platform, chat_id, thread_id)
+    if key in modes:
+        return modes[key]
+    chat_key = group_mode_key(platform, chat_id)
+    return modes.get(chat_key, default)
+
+
+def set_group_mode(
+    hermes_home: Path,
+    *,
+    platform: str,
+    chat_id: str,
+    mode: str,
+    thread_id: str | None = None,
+) -> str:
+    normalized = normalize_group_mode(mode)
+    if normalized not in VALID_GROUP_MODES:
+        raise ValueError(f"Invalid group mode: {mode!r}")
+    modes = _load_state(hermes_home)
+    modes[group_mode_key(platform, chat_id, thread_id)] = normalized
+    _write_state(hermes_home, modes)
+    return normalized
