@@ -0,0 +1,75 @@
+import asyncio
+from types import SimpleNamespace
+
+from gateway.config import GatewayConfig, Platform, PlatformConfig
+from gateway.platforms.base import MessageEvent
+from gateway.session import SessionSource
+
+
+def _make_group_event(text: str = "/gpmode") -> MessageEvent:
+    return MessageEvent(
+        text=text,
+        source=SessionSource(
+            platform=Platform.TELEGRAM,
+            chat_id="-100",
+            chat_name="Test Group",
+            chat_type="group",
+            user_id="111",
+            user_name="Alice",
+        ),
+        message_id="m1",
+    )
+
+
+def _make_runner():
+    from gateway.run import GatewayRunner
+
+    runner = object.__new__(GatewayRunner)
+    runner.config = GatewayConfig(
+        platforms={Platform.TELEGRAM: PlatformConfig(enabled=True, token="***")}
+    )
+    runner.hooks = SimpleNamespace(loaded_hooks=False)
+    return runner
+
+
+def test_gpmode_command_is_registered():
+    from hermes_cli.commands import resolve_command
+
+    cmd = resolve_command("gpmode")
+    assert cmd is not None
+    assert cmd.gateway_only is True
+
+
+def test_gpmode_command_sets_and_reads_group_mode(monkeypatch, tmp_path):
+    import gateway.run as run_mod
+
+    monkeypatch.setattr(run_mod, "_hermes_home", tmp_path)
+    runner = _make_runner()
+
+    set_reply = asyncio.run(runner._handle_gpmode_command(_make_group_event("/gpmode free")))
+    status_reply = asyncio.run(runner._handle_gpmode_command(_make_group_event("/gpmode status")))
+
+    assert "set to `free`" in set_reply
+    assert "Group reply mode: `free`" in status_reply
+
+
+def test_gpmode_command_rejects_dm(monkeypatch, tmp_path):
+    import gateway.run as run_mod
+
+    monkeypatch.setattr(run_mod, "_hermes_home", tmp_path)
+    runner = _make_runner()
+    event = MessageEvent(
+        text="/gpmode free",
+        source=SessionSource(
+            platform=Platform.TELEGRAM,
+            chat_id="111",
+            chat_type="dm",
+            user_id="111",
+            user_name="Alice",
+        ),
+        message_id="m2",
+    )
+
+    reply = asyncio.run(runner._handle_gpmode_command(event))
+
+    assert "only applies to group" in reply
